{
  "name": "personal-website",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio and resume of John Elliott, a single-page React and TypeScript site.",
  "homepage": ".",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "serve": "serve -s build -l 3000",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"postman/**/*.json\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"postman/**/*.json\" \"*.{json,md}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "newman run postman/external-apis.postman_collection.json -e postman/production.postman_environment.json --reporters cli,junit --reporter-junit-export newman/results.xml",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "newman": "^6.2.2",
    "prettier": "^3.4.2",
    "react-scripts": "5.0.1",
    "serve": "^14.2.6",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "typescript": "^5.5.3",
    "nth-check": "^2.1.1",
    "postcss": "^8.5.28",
    "serialize-javascript": "^7.1.1",
    "@svgr/webpack": "^8.1.0",
    "handlebars": "^4.7.9",
    "lodash": "^4.18.1",
    "node-forge": "^1.4.0",
    "jose": "^4.15.9",
    "qs": "^6.16.0",
    "flatted": "^3.4.4",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1",
    "@tootallnate/once": "^2.0.1"
  },
  "jest": {
    "clearMocks": true,
    "restoreMocks": true,
    "resetMocks": false,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/index.tsx",
      "!src/setupTests.ts",
      "!src/test-utils/**",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
